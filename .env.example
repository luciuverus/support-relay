# Скопируй в .env и заполни. Строки с пустым значением — необязательные.

# ---------- Kaiten ----------
KAITEN_BASE_URL=https://ВАШ-ДОМЕН.kaiten.ru/api/latest
KAITEN_TOKEN=
# Ссылка на карточку без id в конце (открой любую карточку и скопируй адрес до id)
KAITEN_CARD_URL_PREFIX=https://ВАШ-ДОМЕН.kaiten.ru/space/ID_ПРОСТРАНСТВА/card/
# Твой id: GET /api/latest/users/current
MY_KAITEN_USER_ID=
# Колонка «В работе»: GET /api/latest/boards/<id доски> -> columns
IN_WORK_COLUMN_ID=
# Колонка «Очередь», откуда брать заявки (можно несколько через запятую).
# Карточки в «Ждём ответа», «Проблемные» и других колонках сервис не трогает
QUEUE_COLUMN_IDS=
# Нужен, только если «В работе» на другой доске
IN_WORK_BOARD_ID=
# Поле карточки с Telegram автора заявки — просто название, как в Kaiten (или id вида id_123).
# Если поле пустое, сервис ищет автора в config/employees.json
AUTHOR_TG_FIELD=Ваш телеграм
# Поле с Telegram клиента (например «Telegram ученика/учителя»). Пусто = клиентам не пишем
CLIENT_TG_FIELD=
# На каких уровнях (дорожках доски) писать ещё и клиенту — родителю/ученику из поля CLIENT_TG_FIELD.
# Куратору тогда уходит короткое «взял, пишу клиенту». Пусто = писать клиенту на всех уровнях.
# Если CLIENT_TG_FIELD пустое, берётся поле «Telegram ученика/учителя»
CLIENT_LANES=2-ой уровень,2-й уровень,второй уровень

# ---------- Кто ты ----------
# Имя для {name} в сообщениях («На связи технический специалист - {name}»). Пусто = первое слово имени из профиля Kaiten
SPECIALIST_NAME=

# ---------- Ждём ответа ----------
# Колонка «Ждём ответа» (id через запятую). Пусто = сервис найдёт её на доске сам по названию
WAITING_COLUMN_IDS=
# Колонка «Повторно связаться», куда Kaiten сам переносит карточку после 6 ч в «Ждём ответа».
# Если она есть, напоминание уходит, как только карточка туда попала (и в чате было тихо FOLLOWUP_AFTER_H),
# а «Ждём ответа» не отслеживается. Пусто = сервис найдёт колонку на доске сам по названию
RECONTACT_COLUMN_IDS=
# Если заявка в «Ждём ответа» и в чате тишина столько часов (случайно в диапазоне) — один раз спросить,
# актуальна ли проблема. Текст — раздел followup в config/messages.json. 0 = выключить
FOLLOWUP_AFTER_H=6-8
# Business-бот не может написать человеку, который ещё не писал на аккаунт. Тогда приветствие ждёт,
# пока человек напишет сам, — столько часов. 0 = не ждать, сразу просить тебя написать вручную
HOLD_UNKNOWN_CHAT_H=24
# Регламент п. 4.5: ты написал автору с корпоративного аккаунта, а его карточка в «Ждём ответа» или
# «Повторно связаться» — перенести её в «В работе» (с кнопкой «Вернуть обратно»). false = выключить
AUTO_TO_WORK=true
# Карточка в «В работе», последнее сообщение в чате наше, автор молчит столько минут — спросить,
# не перенести ли в «Ждём ответа». 0 = выключить
WAIT_HINT_MIN=30
# Бот не может написать первым → готовый текст уходит ещё и в чат корпоративного аккаунта с ботом.
# Кнопка оттуда открывает чат с человеком сразу в корпоративном аккаунте (кнопка в твоих уведомлениях откроет
# его в том аккаунте, где ты их читаешь — обычно в личном). Нужно один раз: в корпоративном аккаунте открыть бота
# и нажать /start. false = выключить
CORP_PREFILL=true
# Если карточку вернули в «Очередь», не здороваться второй раз раньше, чем через столько часов
REGREET_AFTER_H=12

# ---------- Время реакции (решение созвона 09.10.2026) ----------
# classic — как раньше: бот сам переносит заявку в «В работе» и здоровается.
# assess — бот здоровается, а карточка остаётся в «Новой», пока ты не оценишь заявку и не нажмёшь
# «▶️ В работу» (или /work номер): тогда время реакции — это реальное взятие в работу. Подробно — README
REACTION_MODE=classic
# Колонка «Ожидание информации для оценки» (время реакции там на паузе). Пусто = найти на доске по слову «оценк»
ASSESS_WAIT_COLUMN_IDS=
# Ориентировочное время решения для клиента, минуты: одно число или по категориям
# («Камера/Микрофон=60; Bitrix24=120; *=40»). Срок SLA работы в напоминаниях считается так же
ASSESS_ETA_MIN=40
# Не переводить в работу, пока в Kaiten пустая «Фактическая категория проблемы»
ASSESS_REQUIRE_CATEGORY=true
# Напомнить один раз, если карточка висит в «Новой» дольше стольких минут. 0 = не напоминать
ASSESS_REMIND_MIN=4

# ---------- SLA ----------
# Если у карточки нет срока, SLA = столько минут с момента взятия
SLA_MINUTES=240
# Напомнить, когда прошла такая доля времени (0.8 = 80%)
SLA_WARN_SHARE=0.8

# ---------- Как писать с корпоративного аккаунта ----------
# business = официальный Telegram Business (нужен Premium), userbot = сессия аккаунта через Telethon
TRANSPORT=business
# Для business: токен ОТДЕЛЬНОГО бота из @BotFather (не того, что отвечает по базе знаний)
BUSINESS_BOT_TOKEN=
# Для userbot: https://my.telegram.org -> API development tools
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION=data/corp_account
TELEGRAM_API_BASE=https://api.telegram.org

# ---------- Команда на одном боте ----------
# Коллеги, на которых тоже работает бот (тот же корпоративный аккаунт). Файл заполняется сам: коллега пишет
# боту /start, тебе приходит кнопка «👤 Специалист поддержки». Вручную: [{"chat_id": "…", "kaiten_id": 123, "name": "Имя"}]
TEAM_FILE=config/team.json

# ---------- Уведомления лично тебе ----------
# Бот, который пишет тебе (можно тот же, что в BUSINESS_BOT_TOKEN — тогда оставь пустым)
ALERT_BOT_TOKEN=
# Твой chat_id (узнать: написать боту @userinfobot). Сначала нажми /start у бота уведомлений
ALERT_CHAT_ID=

# ---------- «Человечность» ----------
TZ_NAME=Asia/Bishkek
# Твоя смена. Вне неё бот заявки сам не берёт: присылает уведомление с кнопкой «Взять сейчас»,
# а без нажатия берёт в начале смены. Напоминания «актуально ли?» тоже ждут смены.
# Приветствие по уже взятой заявке уходит сразу (регламент п. 4.2)
WORK_HOURS=11:30-20:30
# Рабочие дни: 1=пн … 7=вс. Поддержка работает и в выходные, поэтому по умолчанию — все дни
WORK_DAYS=1-7
# true — брать заявки и вне смены (как было раньше)
TAKE_OUTSIDE_HOURS=false
# Темп сообщений людям: instant (пауза 0–5 с, «печатает…» до 3 с на сообщение),
# fast (10–30 с, до 10 с), slow (40–150 с, до 45 с — как было раньше),
# custom (берёт четыре числа ниже). Меняется и из Telegram командой /speed — без перезапуска
SPEED=fast
# Только для SPEED=custom: пауза перед первым сообщением, секунды (случайно в этом диапазоне)
HUMAN_DELAY_MIN_S=40
HUMAN_DELAY_MAX_S=150
# Скорость «набора» в символах в секунду (статус «печатает…» держится text/скорость секунд)
TYPING_CPS_MIN=4
TYPING_CPS_MAX=7

# ---------- Сервис ----------
# Как сервис узнаёт о новых заявках.
# По умолчанию сам проверяет «Очередь» раз в N секунд — права администратора Kaiten и
# внешний адрес НЕ нужны. Не чаще раза в 10 секунд. 0 = выключить опрос.
POLL_INTERVAL_S=30
# Необязательно: вебхук (нужны права админа пространства). Длинная случайная строка от 12 символов;
# адрес вебхука: https://твой-сервер/kaiten/<WEBHOOK_SECRET>. Пусто = вебхук выключен
WEBHOOK_SECRET=
DB_PATH=data/state.db
# Тексты комментария в Kaiten и сообщений — в config/messages.json (правятся без перезапуска)
EMPLOYEES_FILE=config/employees.json
MESSAGES_FILE=config/messages.json
HOST=0.0.0.0
PORT=8080
# Утром в начале рабочего времени: «работаю» и цифры за сутки
HEARTBEAT=true
# Журнал работы (ключи и токены в нём вычищаются). Пусто = не писать в файл
LOG_FILE=data/relay.log
# true = ничего не отправлять в Telegram, только писать в лог (для первого запуска)
DRY_RUN=true

# ---------- Детектор инцидентов (вся доска: для старшего смены и руководителя) ----------
# true = следить за всей доской: массовые сбои, заявки коллег без ответа, завалы, итоги дня
INCIDENTS=true
# Чат руководителя. Можно не заполнять: пусть руководитель напишет боту уведомлений /start,
# тебе придёт кнопка «Сделать получателем сводок». Руководитель получает только сбои, завалы и итоги дня
MANAGER_CHAT_ID=
# Массовый сбой: столько заявок на одну тему (оплаты, LiveDigital, вход…) за INCIDENT_WINDOW_MIN минут
INCIDENT_SAME_TOPIC=3
# true — считать сбоем только ПОХОЖИЕ заявки одной темы: одинаковый ответ формы «Какая проблема…»
# или общие редкие слова в тексте («оплата картой не РФ» ×3). Разные проблемы Битрикса за полчаса — не сбой.
# false — как раньше: любые заявки одной темы
INCIDENT_BY_TEXT=true
INCIDENT_WINDOW_MIN=30
# Всплеск: столько заявок любых тем за то же время
INCIDENT_SPIKE=8
# Заявка коллеги висит в «Очереди» дольше стольких минут — сообщить тебе (в твоё рабочее время). 0 = выключить
UNTAKEN_ALERT_MIN=5
# То же, но руководителю, дольше стольких минут. 0 = не сообщать руководителю
UNTAKEN_MANAGER_MIN=0
# Завал: столько заявок в «Очереди» на одном уровне. 0 = выключить
BACKLOG_LIMIT=5
# Итоги дня в конце рабочего времени (тебе и руководителю)
DIGEST=true
# В итогах показывать, кто сколько взял и как быстро
DIGEST_BY_PERSON=true
# Отчёт тебе и руководителю: за неделю (в понедельник утром) и за месяц (1-го числа). /report — в любой момент
REPORT_WEEKLY=true
REPORT_MONTHLY=true
# Ссылка на дашборд SLA/KPI. Цифры команды в отчётах бота считаются по его опросу доски (раз в минуту,
# без пауз и рабочего календаря) и подписываются «по данным бота»; точные SLA и KPI — в дашборде.
# Если ссылка задана, она стоит рядом с этой подписью. Пусто — подпись без ссылки
DASHBOARD_URL=

# ---------- Похожие решённые заявки ----------
# База «что помогло в похожих случаях». Собирается из выгрузки Kaiten: перетащи xlsx на import_cases.bat
CASES_FILE=data/cases.json
# Сколько похожих случаев показывать в уведомлении о взятой заявке. 0 = не показывать
SIMILAR_HINTS=3

# ---------- Быстрые ответы → Kaiten ----------
# Поля «Фактическая категория проблемы» (без них Kaiten не закрывает заявку). Пусто = найти самому:
# поле-список — категория, строковое — «что сделали». Можно указать название или id поля
FACT_CATEGORY_FIELD=
FACT_SOLUTION_FIELD=
# true — после «закрываем»/«оценка» бот спрашивает категорию и «что сделали» кнопками и сам заполняет поля.
# false — поля заполняешь в Kaiten сам, бот только напоминает (так советовали на созвоне: поля — в Kaiten)
FIELDS_IN_BOT=true
